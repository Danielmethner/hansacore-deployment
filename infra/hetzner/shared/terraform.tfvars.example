# Copy to terraform.tfvars (git-ignored) and paste your public key on one line:
#   Get-Content $env:USERPROFILE\.ssh\id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Open SSH until you know your address. For a fixed IP use ["203.0.113.10/32"].
# Include an IPv6 CIDR as well if you connect over IPv6.
ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]
