# Copy to keycloak-smtp.env (git-ignored) and fill in real values, or run:
#   scripts/bootstrap-secrets.sh prod
# Rendered into the Keycloak realm (scripts/render-realm.sh). Keycloak uses
# this relay for registration verification and password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@hansacore.com
SMTP_USER=change-me
SMTP_PASSWORD=change-me
