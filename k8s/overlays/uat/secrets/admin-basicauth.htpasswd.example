# Copy to admin-basicauth.htpasswd (git-ignored) or just run:
#   scripts/bootstrap-secrets.sh uat
# Only generated because the base kustomization expects the Secret; the
# gcp-vm component removes the BasicAuth middleware from the admin Ingress.
#
# Format: htpasswd (apr1) — one "user:hash" per line. Generate manually with:
#   openssl passwd -apr1 'your-password-here'
admin:$apr1$REPLACE$WITHYOUROWNHASH0000000000
