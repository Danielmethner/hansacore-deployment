# Copy to keycloak-clients.env (git-ignored) and fill in real values, or run:
#   scripts/bootstrap-secrets.sh uat
# These values are used BOTH for the k8s Secret consumed by portal-gateway
# AND rendered into the Keycloak realm import (scripts/render-realm.sh), so
# the two always stay in sync. MICROSOFT_CLIENT_SECRET: a UAT-only Entra
# client secret *value* (README §4).
PORTAL_GATEWAY_CLIENT_SECRET=change-me
HANSACORE_API_CLIENT_SECRET=change-me
MICROSOFT_CLIENT_SECRET=change-me
